---
import Logo from "./Logo.astro";
import Mark from "./Mark.astro";
import { site, mailto, tel } from "../lib/site";
const year = new Date().getFullYear();
const nav = ["work", "products", "services", "process", "contact"] as const;
---

<footer class="footer">
  <div class="frame">
    <a class="footer__logo" href="/" aria-label={`${site.person.brand}, home`}>
      <Logo size="big" />
    </a>
    <div class="footer__row">
      <span class="footer__brand">
        <Mark size={28} />
        © {year} {site.person.brand} · {site.person.area}
      </span>
      <nav aria-label="Footer">
        <ul class="footer__nav">
          {nav.map((k) => <li><a href={site.pages[k].path}>{site.pages[k].label}</a></li>)}
        </ul>
      </nav>
      <span class="footer__contact"><a href={tel()}>{site.person.phoneDisplay}</a><a href={mailto()}>{site.person.email}</a></span>
    </div>
  </div>
</footer>
