---
import { Image } from "astro:assets";
import logoLong from "../assets/brand/logo-long.png";
import { site, mailto } from "../lib/site";

const nav = ["work", "products", "services", "process", "contact"] as const;
const here = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
---

<header class="header" transition:persist>
  <div class="frame header__row">
    <a class="logo" href="/" aria-label={`${site.person.brand}, home`}>
      <Image src={logoLong} alt="" width={162} height={40} densities={[1, 2, 3]} loading="eager" />
    </a>
    <nav aria-label="Main">
      <ul class="nav">
        {
          nav.map((k) => {
            const p = site.pages[k];
            return (
              <li>
                <a href={p.path} aria-current={here === p.path || here.startsWith(p.path + "/") ? "page" : undefined}>{p.label}</a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <a class="button button--small" href={mailto()}>{site.contact.cta}</a>
    <span class="progress" aria-hidden="true"></span>
  </div>
</header>
