---
import { site, mailto, tel } from "../lib/site";
interface Props {
  title?: string;
  body?: string;
}
const { title = site.contact.title, body = site.contact.body } = Astro.props;
---

<section class="section frame" aria-labelledby="cta-title">
  <div class="cta" data-reveal data-spot>
    <h2 id="cta-title" class="h2 h2--big">{title}</h2>
    <p class="lead">{body}</p>
    <div class="actions">
      <a class="button button--primary" href={mailto()} data-magnetic>{site.contact.cta} <span aria-hidden="true">→</span></a>
      <a class="link-arrow" href={tel()}>Or call {site.person.phoneDisplay} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
