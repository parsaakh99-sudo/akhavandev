---
import { site, sale } from "../lib/site";
const deal = site.websites.deal;
// The deal shows only once its checkout links exist, so no one is sent to email to buy.
// During the holiday sale the sale takes its place (the two don't stack).
const live = site.websites.tiers.some((t) => t.pair?.stripe);
const needsCode = sale && site.websites.tiers.some((t) => !t.saleStripe);
---

{
  sale ? (
    <div class="deal deal--holiday" data-reveal>
      <span class="deal__badge deal__badge--holiday">{sale.percent}% off</span>
      <div class="deal__text">
        <p class="deal__title">{sale.name}: {sale.percent}% off every website package.</p>
        <p class="muted">
          Until {sale.ends}.{needsCode && <> Enter code <strong>{sale.code}</strong> at checkout.</>}
        </p>
      </div>
      <span class="deal__shine" aria-hidden="true"></span>
    </div>
  ) : (
    live && (
      <div class="deal" data-reveal>
        <span class="deal__badge">{deal.badge}</span>
        <div class="deal__text">
          <p class="deal__title">{deal.title}</p>
          <p class="muted">{deal.body}</p>
        </div>
        <span class="deal__shine" aria-hidden="true"></span>
      </div>
    )
  )
}
