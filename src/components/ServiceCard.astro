---
import { Image } from "astro:assets";
import { img } from "../lib/images";
interface Props {
  service: { title: string; body: string; image?: string };
  n: number;
  compact?: boolean;
}
const { service: s, n, compact = false } = Astro.props;
const pic = img(s.image);
---

<li class:list={["panel service", { "service--compact": compact }]} data-reveal data-spot style={`--d:${n - 1}`}>
  {pic && <span class="service__pic"><Image src={pic} alt="" widths={[400, 700]} sizes="(min-width: 720px) 50vw, 100vw" /></span>}
  <span class="index" aria-hidden="true">{String(n).padStart(2, "0")}</span>
  <h3 class="h3">{s.title}</h3>
  <p class="muted">{s.body}</p>
</li>
