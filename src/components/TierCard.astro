---
import Checks from "./Checks.astro";
import { site, buyUrl, sale, salePrice } from "../lib/site";

interface Props {
  tier: {
    name: string;
    amount: string;
    featured?: boolean;
    summary: string;
    features: string[];
    cta: string;
    stripe: string;
    saleStripe?: string;
    pair?: { amount: string; was: string; stripe: string };
    monthly?: { amount: string; count: number; stripe: string };
  };
  d?: number;
}
const { tier: t, d = 0 } = Astro.props;
const deal = site.websites.deal;
// During the sale: the sale price, its own checkout link if there is one, otherwise the code.
// The second-site deal is paused so the two discounts don't stack.
const buy = (sale && t.saleStripe) || t.stripe;
const showPair = !sale && t.pair?.stripe;
---

<li class:list={["panel tier", { "panel--featured": t.featured }]} data-reveal data-spot style={`--d:${d}`}>
  {t.featured && <p class="badge">Most popular</p>}
  <p class="kicker">{t.name}</p>
  {
    sale ? (
      <p class="price__amount price__amount--big sale-price">
        <span data-count>{salePrice(t.amount)}</span>
        <s class="sale-price__was"><span class="sr-only">was </span>{t.amount}</s>
        <span class="sale-price__tag">{sale.percent}% off</span>
      </p>
    ) : (
      <p class="price__amount price__amount--big"><span data-count>{t.amount}</span></p>
    )
  }
  <p class="muted">{t.summary}</p>
  <Checks items={t.features} />
  <div class="tier__buy">
    <a class:list={["button", t.featured ? "button--primary" : "button--ghost"]} href={buyUrl(buy, `${t.name} website`)} data-magnetic={t.featured ? "" : undefined}>
      {t.cta} <span aria-hidden="true">→</span>
    </a>
    {
      sale && !t.saleStripe && (
        <p class="sale-code">Enter code <strong>{sale.code}</strong> at checkout</p>
      )
    }
    {
      showPair && (
        <a class="pair" href={buyUrl(t.pair.stripe, `Two ${t.name} websites (${deal.badge})`)}>
          <span class="pair__tag">{deal.badge}</span>
          <span class="pair__line">
            Buy 2 for <strong>{t.pair.amount}</strong> <s>{t.pair.was}</s> <span aria-hidden="true">→</span>
          </span>
        </a>
      )
    }
    {
      t.monthly?.stripe && (
        <a class="monthly" href={buyUrl(t.monthly.stripe, `${t.name} website, paid monthly`)}>
          Or <strong>$0 down</strong>, {t.monthly.amount}/mo for {t.monthly.count} months <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</li>
