---
// A section's heading: numbered eyebrow, h2, lead, and an optional link to the page it summarises.
interface Props {
  id: string;
  num?: string;
  eyebrow: string;
  title: string;
  lead?: string;
  href?: string;
  cta?: string;
}
const { id, num, eyebrow, title, lead, href, cta } = Astro.props;
---

<div class="section__head" data-reveal>
  <div class="section__titles">
    <p class="eyebrow">{num && <span class="num">{num}</span>} {eyebrow}</p>
    <h2 id={id} class="h2">{title}</h2>
    {lead && <p class="lead">{lead}</p>}
  </div>
  {href && cta && <a class="link-arrow section__more" href={href}>{cta} <span aria-hidden="true">→</span></a>}
</div>
