---
import { Image } from "astro:assets";
import { img } from "../lib/images";
import IPhone from "./IPhone.astro";
import { site, sale } from "../lib/site";

// One tile in the products collage: a picture, a name and a starting price, leading to the product's page.
interface Props {
  product: { id: string; name: string; kind: string; tagline: string; image?: string; imageMobile?: string; from: string; tile?: string; fit?: string; href: string };
  d?: number;
}
const { product: p, d = 0 } = Astro.props;
const pic = img(p.image);
---

<li class:list={["tile", `tile--${p.tile ?? "wide"}`, { "tile--sw": p.id === "scenewise", "tile--contain": p.fit === "contain" }]} data-reveal style={`--d:${d}`}>
  <a class="tile__link" href={p.href}>
    {p.id === "websites" && sale && <span class="tile__ribbon tile__ribbon--holiday">{sale.name}: {sale.percent}% off</span>}
    {p.id === "websites" && !sale && site.websites.tiers.some((t) => t.pair?.stripe) && <span class="tile__ribbon">{site.websites.deal.badge}</span>}
    <span class="tile__art" aria-hidden="true">
      {pic && <Image class="tile__pic" src={pic} alt="" widths={[480, 800, 1200]} sizes="(min-width: 960px) 50vw, 100vw" />}
      {p.imageMobile && <IPhone src={p.imageMobile} alt="" class="tile__phone" />}
    </span>
    <span class="tile__text">
      <span class="kicker">{p.kind}</span>
      <span class="tile__name">{p.name}</span>
      <span class="tile__tagline">{p.tagline}</span>
      <span class="tile__foot"><span class="tile__from">From {p.from}</span><span class="tile__go">See details <span aria-hidden="true">→</span></span></span>
    </span>
  </a>
</li>
