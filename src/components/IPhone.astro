---
import { Image } from "astro:assets";
import { img } from "../lib/images";

// An iPhone 15 Pro, drawn simply: a matte black body with a thin graphite edge, slim side buttons,
// the Dynamic Island, and the screenshot as the whole screen. Nothing is painted over the screenshot.
interface Props {
  src: string;
  alt: string;
  class?: string;
}
const { src, alt, class: cls } = Astro.props;
const image = img(src);
---

<figure class:list={["iphone", cls]}>
  <span class="iphone__btn iphone__btn--action" aria-hidden="true"></span>
  <span class="iphone__btn iphone__btn--up" aria-hidden="true"></span>
  <span class="iphone__btn iphone__btn--down" aria-hidden="true"></span>
  <span class="iphone__btn iphone__btn--power" aria-hidden="true"></span>
  <div class="iphone__screen">
    {image && <Image src={image} alt={alt} widths={[240, 390, 600]} sizes="240px" />}
    <span class="iphone__island" aria-hidden="true"></span>
  </div>
</figure>
