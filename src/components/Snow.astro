---
// Falling snow for the holiday sale, in three depths: small slow flakes far away, soft mid
// flakes, and a few big blurred ones close to the glass, plus slowly turning crystals.
// Decoration only: hidden from screen readers, never catches a tap, off under
// prefers-reduced-motion, paused while the tab is hidden, and lighter on phones.
---

<canvas class="snow" aria-hidden="true" transition:persist="snow"></canvas>

<script>
  type Flake = {
    x: number; y: number; size: number; speed: number; sway: number; phase: number;
    spin: number; angle: number; alpha: number; sprite: HTMLCanvasElement;
  };

  // A soft round flake, drawn once and stamped many times (much cheaper than arcs + blur).
  const softSprite = (r: number, blur: number) => {
    const s = document.createElement("canvas");
    const d = Math.ceil(r * 2 + blur * 4);
    s.width = s.height = d;
    const c = s.getContext("2d")!;
    const g = c.createRadialGradient(d / 2, d / 2, 0, d / 2, d / 2, d / 2);
    g.addColorStop(0, "rgba(255,255,255,1)");
    g.addColorStop(r / (d / 2), "rgba(255,255,255,0.85)");
    g.addColorStop(1, "rgba(255,255,255,0)");
    c.fillStyle = g;
    c.fillRect(0, 0, d, d);
    return s;
  };

  // A six-armed crystal with little side branches.
  const crystalSprite = (r: number) => {
    const s = document.createElement("canvas");
    const d = Math.ceil(r * 2 + 6);
    s.width = s.height = d;
    const c = s.getContext("2d")!;
    c.translate(d / 2, d / 2);
    c.strokeStyle = "rgba(255,255,255,0.95)";
    c.lineWidth = Math.max(1, r / 9);
    c.lineCap = "round";
    c.shadowColor = "rgba(255,255,255,0.8)";
    c.shadowBlur = 4;
    for (let i = 0; i < 6; i++) {
      c.rotate(Math.PI / 3);
      c.beginPath();
      c.moveTo(0, 0);
      c.lineTo(0, -r);
      for (const at of [0.45, 0.7]) {
        const b = r * 0.28 * (1.1 - at);
        c.moveTo(0, -r * at);
        c.lineTo(-b, -r * at - b);
        c.moveTo(0, -r * at);
        c.lineTo(b, -r * at - b);
      }
      c.stroke();
    }
    return s;
  };

  const start = () => {
    const canvas = document.querySelector<HTMLCanvasElement>("canvas.snow");
    if (!canvas || canvas.dataset.on) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    canvas.dataset.on = "1";
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const sprites = {
      far: softSprite(1.2, 0.5),
      mid: softSprite(2.4, 1.5),
      near: softSprite(4.5, 4),
      crystals: [crystalSprite(7), crystalSprite(10), crystalSprite(13)],
    };

    let w = 0;
    let h = 0;
    let flakes: Flake[] = [];
    let wind = 0;
    let gust = 0;

    const make = (layer: number, anywhere: boolean): Flake => {
      const r = Math.random();
      // layer 0 far, 1 mid, 2 near, 3 crystal
      const sprite =
        layer === 0 ? sprites.far : layer === 1 ? sprites.mid : layer === 2 ? sprites.near : sprites.crystals[(r * 3) | 0];
      const depth = [0.45, 0.8, 1.35, 1][layer];
      return {
        x: Math.random() * w,
        y: anywhere ? Math.random() * h : -30,
        size: sprite.width * (0.75 + Math.random() * 0.5),
        speed: (0.35 + Math.random() * 0.5) * depth,
        sway: (0.4 + Math.random() * 0.8) * depth,
        phase: Math.random() * Math.PI * 2,
        spin: layer === 3 ? (Math.random() - 0.5) * 0.02 : 0,
        angle: Math.random() * Math.PI,
        alpha: [0.55, 0.75, 0.5, 0.85][layer] * (0.7 + Math.random() * 0.3),
        sprite,
      };
    };

    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = innerWidth;
      h = innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // About 70 flakes on a phone, ~190 on a laptop.
      const n = Math.min(200, Math.round((w * h) / 5500));
      const plan: [number, number][] = [[0, 0.5], [1, 0.33], [2, 0.09], [3, 0.08]];
      flakes = plan.flatMap(([layer, share]) => Array.from({ length: Math.round(n * share) }, () => make(layer, true)));
    };

    let last = performance.now();
    let frame = 0;
    const tick = (now: number) => {
      const dt = Math.min(3, (now - last) / 16.7);
      last = now;
      // A slow wind that now and then picks up into a gust and dies away.
      if (Math.random() < 0.002) gust = (Math.random() - 0.3) * 2.2;
      gust *= 0.995;
      wind += (gust - wind) * 0.01;
      ctx.clearRect(0, 0, w, h);
      for (const f of flakes) {
        f.phase += 0.012 * dt;
        f.y += f.speed * dt;
        f.x += (Math.sin(f.phase) * f.sway * 0.6 + wind * f.speed) * dt;
        f.angle += f.spin * dt;
        if (f.y > h + 30 || f.x < -40 || f.x > w + 40) {
          const layer = f.spin ? 3 : f.sprite === sprites.far ? 0 : f.sprite === sprites.mid ? 1 : 2;
          Object.assign(f, make(layer, false));
          if (wind > 0.3) f.x -= w * 0.2;
        }
        ctx.globalAlpha = f.alpha;
        const s = f.size;
        if (f.spin) {
          ctx.save();
          ctx.translate(f.x, f.y);
          ctx.rotate(f.angle);
          ctx.drawImage(f.sprite, -s / 2, -s / 2, s, s);
          ctx.restore();
        } else {
          ctx.drawImage(f.sprite, f.x - s / 2, f.y - s / 2, s, s);
        }
      }
      frame = requestAnimationFrame(tick);
    };

    resize();
    addEventListener("resize", resize);
    document.addEventListener("visibilitychange", () => {
      cancelAnimationFrame(frame);
      if (!document.hidden) {
        last = performance.now();
        frame = requestAnimationFrame(tick);
      }
    });
    // Start once the page has painted, so it never competes with first load.
    const go = () => (frame = requestAnimationFrame(tick));
    "requestIdleCallback" in window ? requestIdleCallback(go, { timeout: 600 }) : setTimeout(go, 300);
  };
  document.addEventListener("astro:page-load", start);
</script>
