---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import ProductCard from "../components/ProductCard.astro";
import TierCard from "../components/TierCard.astro";
import Scenewise from "../components/Scenewise.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "../lib/site";

const page = site.pages.products;
const { products, websites } = site;
---

<Base title={page.title} description={page.description}>
  <PageHero {...page.hero}>
    <a class="button button--primary" href="#apps" data-magnetic>Browse apps and tools <span aria-hidden="true">↓</span></a>
    <a class="link-arrow" href="#websites">Website packages <span aria-hidden="true">↓</span></a>
  </PageHero>

  <section id="apps" class="section frame" aria-labelledby="apps-title">
    <SectionHead id="apps-title" num="01" eyebrow="Apps and tools" title="Software you can start using today" lead="Buy once or subscribe. Checkout is handled by Stripe." />
    <ul class="grid grid--2">
      {products.map((p, i) => <ProductCard product={p} d={i} />)}
    </ul>
  </section>

  <section id="websites" class="section frame" aria-labelledby="websites-title">
    <SectionHead id="websites-title" num="02" eyebrow="Website packages" title={websites.title} lead={websites.body} />
    <ul class="grid grid--3 grid--tiers">
      {websites.tiers.map((t, i) => <TierCard tier={t} d={i} />)}
    </ul>
    <p class="note note--center" data-reveal><span aria-hidden="true">🔒</span> Checkout is handled by Stripe. Card details never touch this site.</p>
  </section>

  <Scenewise />

  <CtaBand title="Not sure which one fits?" body="Tell me about your business and I’ll point you to the right package. I reply within a day." />
</Base>
