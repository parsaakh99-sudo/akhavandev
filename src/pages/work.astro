---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "../lib/site";

const page = site.pages.work;
const work = site.work.filter((w) => w.show);
---

<Base title={page.title} description={page.description}>
  <PageHero {...page.hero} />
  <section class="section frame" aria-label="Projects">
    <div class="stack">
      {work.map((w) => <ProjectCard work={w} />)}
    </div>
    <p class="note note--center" data-reveal>More client sites are on the way and will appear here once each client is happy to be shown.</p>
  </section>
  <CtaBand title="Want yours here next?" />
</Base>
