---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import ServiceCard from "../components/ServiceCard.astro";
import Checks from "../components/Checks.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "../lib/site";

const page = site.pages.services;
---

<Base title={page.title} description={page.description}>
  <PageHero {...page.hero}>
    <a class="button button--primary" href={site.pages.products.path + "#websites"} data-magnetic>See website packages <span aria-hidden="true">→</span></a>
  </PageHero>

  <section class="section frame" aria-label="Services">
    <ul class="grid grid--2">
      {site.services.map((s, i) => <ServiceCard service={s} n={i + 1} />)}
    </ul>
  </section>

  <section class="section frame" aria-labelledby="included-title">
    <SectionHead id="included-title" eyebrow="Every site" title="Included with every build" lead="No matter the package, these come standard." />
    <div class="panel" data-reveal>
      <Checks items={site.promises} label="What every site includes" inline />
    </div>
  </section>

  <CtaBand />
</Base>
