---
import Base from "../layouts/Base.astro";
import { site, mailto } from "../lib/site";

// Stripe sends buyers here after paying: /thanks?p=<product id>.
// Each product says exactly what happens next, so nobody is left waiting or guessing.
const next = site.afterPurchase;
---

<Base title="Thank you · Akhavan Developers" description="Your payment went through." noindex>
  <section class="frame thanks">
    <p class="eyebrow"><span class="pulse" aria-hidden="true"></span> Payment received</p>
    <h1 class="h2 h2--big">Thank you. You’re all set.</h1>
    <p class="lead" data-default>Stripe has emailed you a receipt. Here’s what happens next.</p>

    {
      Object.entries(next).map(([id, n]) => (
        <div class="thanks__card" data-product={id} hidden={id !== "default"}>
          <h2 class="h3 h3--big">{n.title}</h2>
          <ol class="thanks__steps">
            {n.steps.map((s) => <li>{s}</li>)}
          </ol>
        </div>
      ))
    }

    <div class="actions">
      <a class="button button--glow" href="/">Back to the site <span aria-hidden="true">→</span></a>
      <a class="link-arrow" href={mailto("Question about my order")}>Questions? {site.person.email}</a>
    </div>
  </section>
  <script>
    const id = new URLSearchParams(location.search).get("p");
    const card = id && document.querySelector<HTMLElement>(`.thanks__card[data-product="${CSS.escape(id)}"]`);
    if (card) {
      document.querySelector<HTMLElement>('.thanks__card[data-product="default"]')!.hidden = true;
      card.hidden = false;
    }
  </script>
</Base>
