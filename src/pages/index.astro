---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import { site, mailto } from "../lib/site";

const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/work/*.png", { eager: true });
const shot = (name: string) => (name ? shots[`../assets/work/${name}.png`]?.default : undefined);
const work = site.work.filter((w) => w.show);
const { hero, services, promises, process, contact } = site;
---

<Base title={site.meta.title} description={site.meta.description}>
  <section class="hero frame">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1 class="display">{hero.title}</h1>
    <p class="lead">{hero.lead}</p>
    <div class="actions">
      <a class="button" href={mailto()}>{hero.cta}</a>
      {work.length > 0 && <a class="link-arrow" href="#work">{hero.secondary} <span aria-hidden="true">↓</span></a>}
    </div>
    <ul class="promises" aria-label="What every site includes">
      {promises.map((p) => <li>{p}</li>)}
    </ul>
  </section>

  {
    work.length > 0 && (
      <section id="work" class="section frame" aria-labelledby="work-title">
        <div class="section__head">
          <p class="eyebrow">Recent work</p>
          <h2 id="work-title" class="h2">Selected builds</h2>
        </div>
        {work.map((w) => {
          const desk = shot(w.image);
          const mob = shot(w.imageMobile);
          return (
            <article class="project" data-reveal>
              <div class="project__media">
                {desk && (
                  <figure class="browser">
                    <span class="browser__bar" aria-hidden="true"><i /><i /><i /></span>
                    <Image src={desk} alt={`${w.name} website on a laptop-sized screen`} widths={[640, 960, 1440]} sizes="(min-width: 960px) 760px, 100vw" />
                  </figure>
                )}
                {mob && (
                  <figure class="phone">
                    <Image src={mob} alt={`${w.name} website on a phone`} widths={[200, 390]} sizes="200px" />
                  </figure>
                )}
              </div>
              <div class="project__text">
                <p class="project__meta">{w.kind} · {w.place} · {w.year}</p>
                <h3 class="h3">{w.name}</h3>
                <p>{w.summary}</p>
                <ul class="tags" aria-label="Built with">
                  {w.tags.map((t) => <li>{t}</li>)}
                </ul>
                {w.url && <a class="link-arrow" href={w.url} rel="noopener">Visit the site <span aria-hidden="true">↗</span></a>}
              </div>
            </article>
          );
        })}
      </section>
    )
  }

  <section id="services" class="section frame" aria-labelledby="services-title">
    <div class="section__head">
      <p class="eyebrow">Services</p>
      <h2 id="services-title" class="h2">What I can build for you</h2>
    </div>
    <ul class="cards">
      {
        services.map((s) => (
          <li class="card" data-reveal>
            <h3 class="h3">{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="process" class="section frame" aria-labelledby="process-title">
    <div class="section__head">
      <p class="eyebrow">Process</p>
      <h2 id="process-title" class="h2">How it works</h2>
    </div>
    <ol class="steps">
      {
        process.map((p) => (
          <li class="step" data-reveal>
            <h3 class="h3">{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="contact" class="section frame" aria-labelledby="contact-title">
    <div class="contact" data-reveal>
      <h2 id="contact-title" class="h2">{contact.title}</h2>
      <p class="lead">{contact.body}</p>
      <a class="button button--light" href={mailto()}>{contact.cta}</a>
      <p class="contact__address">{site.person.email}</p>
    </div>
  </section>
</Base>
