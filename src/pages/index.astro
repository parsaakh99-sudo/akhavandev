---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import mark from "../assets/brand/mark.png";
import { site, mailto } from "../lib/site";

const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/work/*.png", { eager: true });
const shot = (name: string) => (name ? shots[`../assets/work/${name}.png`]?.default : undefined);
const work = site.work.filter((w) => w.show);
const { hero, services, promises, process, contact, marquee } = site;

// The headline animates in word by word; its last word is lit in the accent.
const words = hero.title.split(" ");
const last = words.length - 1;
---

<Base title={site.meta.title} description={site.meta.description}>
  <section class="hero frame">
    <div class="hero__copy">
      <p class="eyebrow hero__in" style="--d:0">
        <span class="pulse" aria-hidden="true"></span>{hero.eyebrow}
      </p>
      <h1 class="display" aria-label={hero.title}>
        {
          words.map((w, i) => (
            <span class="word" aria-hidden="true" style={`--d:${i + 1}`}>
              <span class:list={["word__in", { "word__in--lit": i === last }]}>{w}</span>
            </span>
          ))
        }
      </h1>
      <p class="lead hero__in" style={`--d:${words.length + 1}`}>{hero.lead}</p>
      <div class="actions hero__in" style={`--d:${words.length + 2}`}>
        <a class="button button--glow" href={mailto()}>{hero.cta} <span aria-hidden="true">→</span></a>
        {work.length > 0 && <a class="link-arrow" href="#work">{hero.secondary} <span aria-hidden="true">↓</span></a>}
      </div>
    </div>
    <div class="hero__mark" aria-hidden="true">
      <span class="hero__ring"></span>
      <span class="hero__ring hero__ring--2"></span>
      <Image src={mark} alt="" width={320} height={320} loading="eager" class="hero__logo" />
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {
        [0, 1].map(() => (
          <ul class="marquee__list">
            {marquee.map((m) => (
              <li>
                {m}
                <span class="marquee__star">✦</span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
  <ul class="sr-only">{marquee.map((m) => <li>{m}</li>)}</ul>

  {
    work.length > 0 && (
      <section id="work" class="section frame" aria-labelledby="work-title">
        <div class="section__head" data-reveal>
          <p class="eyebrow"><span class="num">01</span> Recent work</p>
          <h2 id="work-title" class="h2">Selected builds</h2>
        </div>
        {work.map((w) => {
          const desk = shot(w.image);
          const mob = shot(w.imageMobile);
          return (
            <article class="project" data-reveal data-spot>
              <div class="project__stage" data-tilt>
                <div class="project__media">
                  {desk && (
                    <figure class="browser">
                      <span class="browser__bar" aria-hidden="true"><i /><i /><i /></span>
                      <Image src={desk} alt={`${w.name} website on a laptop-sized screen`} widths={[640, 960, 1440]} sizes="(min-width: 960px) 760px, 100vw" />
                    </figure>
                  )}
                  {mob && (
                    <figure class="phone">
                      <Image src={mob} alt={`${w.name} website on a phone`} widths={[200, 390]} sizes="200px" />
                    </figure>
                  )}
                </div>
              </div>
              <div class="project__text">
                <p class="project__meta">{w.kind} · {w.place} · {w.year}</p>
                <h3 class="h3 h3--big">{w.name}</h3>
                <p>{w.summary}</p>
                <ul class="tags" aria-label="Built with">
                  {w.tags.map((t) => <li>{t}</li>)}
                </ul>
                {w.url && <a class="link-arrow" href={w.url} rel="noopener">Visit the site <span aria-hidden="true">↗</span></a>}
              </div>
            </article>
          );
        })}
      </section>
    )
  }

  <section id="services" class="section frame" aria-labelledby="services-title">
    <div class="section__head" data-reveal>
      <p class="eyebrow"><span class="num">02</span> Services</p>
      <h2 id="services-title" class="h2">What I can build for you</h2>
    </div>
    <ul class="cards">
      {
        services.map((s, i) => (
          <li class="card" data-reveal data-spot style={`--d:${i}`}>
            <span class="card__num" aria-hidden="true">0{i + 1}</span>
            <h3 class="h3">{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ul>
    <ul class="promises" aria-label="What every site includes" data-reveal>
      {promises.map((p) => <li>{p}</li>)}
    </ul>
  </section>

  <section id="process" class="section frame" aria-labelledby="process-title">
    <div class="section__head" data-reveal>
      <p class="eyebrow"><span class="num">03</span> Process</p>
      <h2 id="process-title" class="h2">How it works</h2>
    </div>
    <ol class="steps">
      {
        process.map((p, i) => (
          <li class="step" data-reveal style={`--d:${i}`}>
            <span class="step__num" aria-hidden="true">0{i + 1}</span>
            <h3 class="h3">{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="contact" class="section frame" aria-labelledby="contact-title">
    <div class="contact" data-reveal data-spot>
      <h2 id="contact-title" class="h2 h2--big">{contact.title}</h2>
      <p class="lead">{contact.body}</p>
      <a class="button button--glow" href={mailto()}>{contact.cta} <span aria-hidden="true">→</span></a>
      <p class="contact__address">{site.person.email}</p>
    </div>
  </section>
</Base>
