---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Marquee from "../components/Marquee.astro";
import SectionHead from "../components/SectionHead.astro";
import ProjectCard from "../components/ProjectCard.astro";
import NextProject from "../components/NextProject.astro";
import ProductTile from "../components/ProductTile.astro";
import ServiceCard from "../components/ServiceCard.astro";
import Steps from "../components/Steps.astro";
import CtaBand from "../components/CtaBand.astro";
import Mark from "../components/Mark.astro";
import { site, mailto, allProducts } from "../lib/site";

const { hero, pages, services, process } = site;
const featured = site.work.find((w) => w.show);
---

<Base title={site.meta.title} description={site.meta.description}>
  <PageHero eyebrow={hero.eyebrow} title={hero.title} lead={hero.lead} size="display">
    <a class="button button--primary button--big" href={mailto()} data-magnetic>{hero.cta} <span aria-hidden="true">→</span></a>
    <a class="link-arrow" href={pages.work.path}>{hero.secondary} <span aria-hidden="true">→</span></a>
    <div class="hero__mark" slot="aside" aria-hidden="true">
      <span class="hero__ring"></span>
      <span class="hero__ring hero__ring--2"></span>
      <Mark size={320} class="hero__logo" />
    </div>
  </PageHero>

  <Marquee />

  <section class="section frame" aria-labelledby="work-title">
    <SectionHead id="work-title" num="01" {...pages.work.teaser} href={pages.work.path} />
    {featured ? <ProjectCard work={featured} /> : <NextProject />}
  </section>

  <section class="section frame" aria-labelledby="products-title">
    <SectionHead id="products-title" num="02" {...pages.products.teaser} href={pages.products.path} />
    <ul class="collage">
      {allProducts().map((p, i) => <ProductTile product={p} d={i} />)}
    </ul>
  </section>

  <section class="section frame" aria-labelledby="services-title">
    <SectionHead id="services-title" num="03" {...pages.services.teaser} href={pages.services.path} />
    <ul class="grid grid--4">
      {services.map((s, i) => <ServiceCard service={s} n={i + 1} />)}
    </ul>
  </section>

  <section class="section frame" aria-labelledby="process-title">
    <SectionHead id="process-title" num="04" {...pages.process.teaser} href={pages.process.path} />
    <Steps steps={process} />
  </section>

  <CtaBand />
</Base>
