---
import fontWoff2 from "@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site, absoluteUrl, personJsonLd } from "../lib/site";

// One variable face (weight and width axes), the closest open match to the logo's lettering.
// It swaps over an Arial fallback sized close to it, so text paints at once.
const fontCss = `
@font-face{font-family:"Archivo Variable";font-style:normal;font-weight:100 900;font-stretch:62% 125%;font-display:swap;src:url(${fontWoff2}) format("woff2-variations"),url(${fontWoff2}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"Archivo Fallback";font-style:normal;font-weight:100 900;src:local("Arial"),local("ArialMT");size-adjust:101%;ascent-override:89%;descent-override:21%;line-gap-override:0%}
`;

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = absoluteUrl(Astro.url.pathname.replace(/\/index(\.html)?$/, "/"));
const t = site.theme;
const rootStyle = [
  `--bg:${t.bg}`,
  `--surface:${t.surface}`,
  `--raised:${t.raised}`,
  `--ink:${t.ink}`,
  `--muted:${t.muted}`,
  `--accent:${t.accent}`,
  `--accent-ink:${t.accentInk}`,
  `--font:${t.font}`,
].join(";");
---

<!doctype html>
<html lang="en" style={rootStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={t.bg} />
    <link rel="preload" as="font" type="font/woff2" href={fontWoff2} crossorigin />
    <Fragment set:html={`<style>${fontCss}</style>`} />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.person.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl("/og.png")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content="en_US" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(personJsonLd())} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="glow" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;

      // Reveals: each [data-reveal] block rises into place once, the first time it scrolls into view.
      const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-in");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add("is-in"));
      }

      if (fine && !still) {
        // A soft amber light follows the pointer across the page.
        const root = document.documentElement;
        addEventListener(
          "pointermove",
          (e) => {
            root.style.setProperty("--mx", `${e.clientX}px`);
            root.style.setProperty("--my", `${e.clientY}px`);
          },
          { passive: true },
        );

        // Cards light up where the pointer is.
        document.querySelectorAll<HTMLElement>("[data-spot]").forEach((el) => {
          el.addEventListener("pointermove", (e) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty("--sx", `${e.clientX - r.left}px`);
            el.style.setProperty("--sy", `${e.clientY - r.top}px`);
          });
        });

        // The project showcase tilts toward the pointer.
        document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((el) => {
          el.addEventListener("pointermove", (e) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;
            el.style.setProperty("--rx", `${(-y * 6).toFixed(2)}deg`);
            el.style.setProperty("--ry", `${(x * 8).toFixed(2)}deg`);
          });
          el.addEventListener("pointerleave", () => {
            el.style.setProperty("--rx", "0deg");
            el.style.setProperty("--ry", "0deg");
          });
        });
      }
    </script>
  </body>
</html>
