---
import fontWoff2 from "@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SaleRibbon from "../components/SaleRibbon.astro";
import Snow from "../components/Snow.astro";
import { ClientRouter } from "astro:transitions";
import { site, absoluteUrl, personJsonLd, sale } from "../lib/site";

// One variable face (weight and width axes), the closest open match to the logo's lettering.
// It swaps over an Arial fallback sized close to it, so text paints at once.
const fontCss = `
@font-face{font-family:"Archivo Variable";font-style:normal;font-weight:100 900;font-stretch:62% 125%;font-display:swap;src:url(${fontWoff2}) format("woff2-variations"),url(${fontWoff2}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"Archivo Fallback";font-style:normal;font-weight:100 900;src:local("Arial"),local("ArialMT");size-adjust:101%;ascent-override:89%;descent-override:21%;line-gap-override:0%}
`;

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

// Moving between pages: the old page lifts away, the new one rises in. Keyframes are in global.css.
const leave = { name: "page-out", duration: "260ms", easing: "cubic-bezier(0.4, 0, 1, 1)", fillMode: "both" };
const enter = { name: "page-in", duration: "560ms", easing: "cubic-bezier(0.22, 1, 0.36, 1)", delay: "80ms", fillMode: "both" };
const pageMotion = { forwards: { old: leave, new: enter }, backwards: { old: leave, new: enter } };
const canonical = absoluteUrl(Astro.url.pathname.replace(/\/index(\.html)?$/, "/"));
const t = site.theme;
const rootStyle = [
  `--bg:${t.bg}`,
  `--surface:${t.surface}`,
  `--raised:${t.raised}`,
  `--ink:${t.ink}`,
  `--muted:${t.muted}`,
  `--accent:${t.accent}`,
  `--accent-ink:${t.accentInk}`,
  `--font:${t.font}`,
].join(";");
---

<!doctype html>
<html lang="en" style={rootStyle} class={sale ? "holiday" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={t.bg} />
    <link rel="preload" as="font" type="font/woff2" href={fontWoff2} crossorigin />
    <Fragment set:html={`<style>${fontCss}</style>`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.person.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl("/og.png")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content="en_US" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <ClientRouter fallback="swap" />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(personJsonLd())} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="aurora" aria-hidden="true" transition:persist><i></i><i></i><i></i><i></i></div>
    <div class="glow" aria-hidden="true" transition:persist></div>
    {sale?.snow && <Snow />}
    <SaleRibbon />
    <Header />
    <main id="main" transition:animate={pageMotion}>
      <slot />
    </main>
    <Footer />
    <script>
      // All page motion. Set up once per page, including pages reached through the transition router.
      // Everything here is skipped under prefers-reduced-motion, and nothing depends on it to be readable.
      const still = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
      const fine = () => matchMedia("(hover: hover) and (pointer: fine)").matches;
      let io: IntersectionObserver | undefined;

      // The pointer light and the scroll bar live outside <main>, so they are bound once.
      let bound = false;
      function bindOnce() {
        if (bound) return;
        bound = true;
        const root = document.documentElement;
        addEventListener("pointermove", (e) => {
          root.style.setProperty("--mx", `${e.clientX}px`);
          root.style.setProperty("--my", `${e.clientY}px`);
        }, { passive: true });
        const progress = () => {
          const max = root.scrollHeight - innerHeight;
          root.style.setProperty("--progress", max > 0 ? String(scrollY / max) : "0");
        };
        addEventListener("scroll", progress, { passive: true });
        addEventListener("resize", progress, { passive: true });
        document.addEventListener("astro:page-load", progress);
        progress();
      }

      // Prices count up from zero the first time they are seen, then settle on the written value.
      function countUp(el: HTMLElement) {
        const text = el.dataset.final ?? el.textContent ?? "";
        el.dataset.final = text;
        const target = Number(text.replace(/[^0-9.]/g, ""));
        if (!target || still()) return;
        const prefix = text.match(/^[^0-9]*/)?.[0] ?? "";
        const t0 = performance.now();
        const dur = 900;
        const step = (t: number) => {
          const k = Math.min(1, (t - t0) / dur);
          const v = Math.round(target * (1 - Math.pow(1 - k, 3)));
          el.textContent = k < 1 ? prefix + v.toLocaleString("en-US") : text;
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
        // If frames are paused (a background tab), never leave a half-counted price on screen.
        setTimeout(() => (el.textContent = text), dur + 150);
      }

      function setup() {
        bindOnce();

        // The menu marks the page you are on (the header persists across pages, so it is updated here).
        const here = location.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
        document.querySelectorAll<HTMLAnchorElement>(".nav a").forEach((a) => {
          const href = a.getAttribute("href") ?? "";
          if (here === href || here.startsWith(href + "/")) a.setAttribute("aria-current", "page");
          else a.removeAttribute("aria-current");
        });
        // On phones the menu is a scrolling row: keep the current page's tab in view.
        const navRow = document.querySelector<HTMLElement>(".header nav");
        const current = navRow?.querySelector<HTMLElement>('[aria-current="page"]');
        if (navRow && current && navRow.scrollWidth > navRow.clientWidth) {
          navRow.scrollLeft = current.offsetLeft - navRow.clientWidth / 2 + current.offsetWidth / 2;
        }

        // Reveals: each [data-reveal] block rises into place once, the first time it scrolls into view.
        io?.disconnect();
        const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
        if ("IntersectionObserver" in window) {
          io = new IntersectionObserver((entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("is-in");
              e.target.querySelectorAll<HTMLElement>("[data-count]").forEach(countUp);
              io!.unobserve(e.target);
            }
          }, { rootMargin: "0px 0px -8% 0px" });
          items.forEach((el) => io!.observe(el));
        } else {
          items.forEach((el) => el.classList.add("is-in"));
        }

        if (!fine() || still()) return;

        // Cards light up where the pointer is.
        document.querySelectorAll<HTMLElement>("[data-spot]").forEach((el) => {
          el.addEventListener("pointermove", (e) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty("--sx", `${e.clientX - r.left}px`);
            el.style.setProperty("--sy", `${e.clientY - r.top}px`);
          });
        });

        // The project showcase tilts toward the pointer.
        document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((el) => {
          el.addEventListener("pointermove", (e) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;
            el.style.setProperty("--rx", `${(-y * 6).toFixed(2)}deg`);
            el.style.setProperty("--ry", `${(x * 8).toFixed(2)}deg`);
          });
          el.addEventListener("pointerleave", () => {
            el.style.setProperty("--rx", "0deg");
            el.style.setProperty("--ry", "0deg");
          });
        });

        // Primary buttons lean toward the pointer a little.
        document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((el) => {
          el.addEventListener("pointermove", (e) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty("--tx", `${((e.clientX - r.left - r.width / 2) * 0.18).toFixed(1)}px`);
            el.style.setProperty("--ty", `${((e.clientY - r.top - r.height / 2) * 0.3).toFixed(1)}px`);
          });
          el.addEventListener("pointerleave", () => {
            el.style.setProperty("--tx", "0px");
            el.style.setProperty("--ty", "0px");
          });
        });
      }

      document.addEventListener("astro:page-load", setup);
    </script>
  </body>
</html>
